# Default local replay uses bundled fixtures and recorded model responses.
TRANSCRIPT_SOURCE=fixture
LLM_MODE=recorded
WEBHOOK_HOST=127.0.0.1
PORT=3000
OUTPUT_DIR=out

# Required for live transcript reads.
MEETSTREAM_API_KEY=
# Required in either live mode. Use the signed workspace endpoint secret.
# WEBHOOK_SECRET is supported as a fallback name.
MEETSTREAM_WEBHOOK_SECRET=
# Required for LLM_MODE=gemini or the opt-in provider smoke.
# GOOGLE_API_KEY is supported as a fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Set to 1 only to allow the optional live smoke in pytest.
# MEETING_CREW_LIVE_TEST=1
